    "who_are_you": {
      "npcText": "Name's Bron. Retired adventurer. Decided sitting by fires beats dying in dungeons.",
      "responses": [
        {
          "text": "Sounds wise.",
          "actions": [
            {
              "type": "goToConversation",
              "node": "start"
            }
          ]
        },
        {
          "text": "Goodbye.",
          "actions": [
            {
              "type": "leave"
            }
          ]
        }
      ]
    },
    "about_place": {
      "npcText": "This used to be a waystation for adventurers. Now it's just me and my drink.",
      "responses": [
        {
          "text": "Thanks for the info.",
          "actions": [
            {
              "type": "goToConversation",
              "node": "start"
            }
          ]
        },
        {
          "text": "Goodbye.",
          "actions": [
            {
              "type": "leave"
            }
          ]
        }
      ]
    },
    "survived_dungeon": {
      "npcText": "You made it out? Ha! Wasn't sure you had it in ya. Most don't come back from that place. Here, take this. Old wayfinder's charm. Kept me alive more times than I care to count.",
      "actions": [
        {
          "type": "loot",
          "item": "wayfinder_charm",
          "received": true
        },
        {
          "type": "set_flag",
          "flag": "received_brons_charm",
          "value": true
        }
      ],
      "responses": [
        {
          "text": "Thank you, Bron.",
          "actions": [
            {
              "type": "goToConversation",
              "node": "charm_given"
            }
          ]
        }
      ]
    },
    "charm_given": {
      "npcText": "Don't mention it. Just don't go dyin' on me now.",
      "responses": [
        {
          "text": "I won't. Thanks, Bron.",
          "actions": [
            {
              "type": "leave"
            }
          ]
        }
      ]
    },
    "after_charm": {
      "npcText": "Good. That charm'll keep the worst of it off ya. Trust me.",
      "responses": [
        {
          "text": "Cheers, Bron.",
          "actions": [
            {
              "type": "leave"
            }
          ]
        }
      ]
    },
    "sunstone_story": {
      "npcText": "Relics, eh? The waystation had one worth the name — a sunstone, big as my fist, lit the whole common room without a flame. Shattered when the lower halls caved in. They say the shards still glow down there, warm as a hearth. If you're crawling that dungeon anyway, keep your eyes open.",
      "actions": [
        {
          "type": "questTrigger",
          "mission": "sunstone_shards",
          "status": "active"
        }
      ],
      "responses": [
        {
          "text": "I'll keep an eye out.",
          "actions": [
            {
              "type": "goToConversation",
              "node": "start"
            }
          ]
        },
        {
          "text": "Goodbye.",
          "actions": [
            {
              "type": "leave"
            }
          ]
        }
      ]
    },
    "sunstone_shown": {
      "npcText": "Well, I'll be. That's the sunstone, all right — still warm after all these years. Keep 'em. They'll do more good in that museum of yours than in my pocket. Just let an old dwarf come look at 'em now and then.",
      "actions": [
        {
          "type": "questTrigger",
          "mission": "sunstone_shards",
          "status": "complete"
        }
      ],
      "responses": [
        {
          "text": "You're welcome anytime, Bron.",
          "actions": [
            {
              "type": "goToConversation",
              "node": "start"
            }
          ]
        },
        {
          "text": "Goodbye.",
          "actions": [
            {
              "type": "leave"
            }
          ]
        }
      ]
    }
  }
