    "start": {
      "npcText": "Aye, you look like you've had a rough time. The dungeon'll do that to ya.",
      "responses": [
        {
          "text": "Who are you?",
          "actions": [
            {
              "type": "goToConversation",
              "node": "who_are_you"
            }
          ]
        },
        {
          "text": "What do you know about this place?",
